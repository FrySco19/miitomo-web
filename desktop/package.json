{
  "name": "miitomo-desktop",
  "productName": "Miitomo Web",
  "version": "0.1.1",
  "description": "Desktop app for Miitomo Web (Classic) and Miitomo Reboot: local accounts, launcher, peer-to-peer friends. Runs only on the user's own game files.",
  "main": "main.cjs",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:client": "npm --prefix ../client/web run build",
    "dist:win": "electron-builder --win portable --x64",
    "dist:win-zip": "electron-builder --win zip --x64",
    "dist:linux": "electron-builder --linux dir"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "io.github.frysco19.miitomoweb",
    "productName": "Miitomo Web",
    "artifactName": "MiitomoWeb-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**",
      "ui/**",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../client/web/dist",
        "to": "client"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "MiitomoWeb-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    }
  },
  "author": "Miitomo Web contributors"
}
